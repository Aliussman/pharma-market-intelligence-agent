# LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# Web Intelligence
# Optional: set to enable Tavily web search. Otherwise the agent falls back to RSS feeds.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
BRIEF_MAX_SOURCES=10

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO